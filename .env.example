# =============================================================================
# MIST.AI Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed.
#
# How values reach the backend process: docker-compose interpolates ${VAR}
# from .env for host-side concerns (ports, model files, bind mounts) AND
# loads this file into the mist-backend container via env_file, so every
# documented variable reaches the server process. Active (uncommented)
# values are kept in sync with the code defaults; commented entries document
# optional overrides.
#
# MIST_EVAL_ISOLATION is deliberately NOT listed here: it is per-run by
# design (the eval runbook passes it via `docker compose exec -e`); a
# standing value would force every backend run into eval mode.

# -----------------------------------------------------------------------------
# Neo4j Configuration
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://mist-neo4j:7687
# For native (non-Docker) mode: NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# LLM Backend
# -----------------------------------------------------------------------------
LLM_BACKEND=llamacpp              # "llamacpp" (llama-server) or "ollama" (fallback)
LLM_SERVER_URL=http://mist-llm:8080  # Docker internal URL
# For native (non-Docker) mode:
# LLM_SERVER_URL=http://localhost:8080
MODEL=gemma-4-e4b

# Model files (host paths)
MODELS_DIR=./models               # Host directory with GGUF files
LLM_MODEL_FILE=unsloth/gemma-4-E4B-it-Q5_K_M.gguf
LLM_CTX_SIZE=32768                # llama-server ctx; effective attention ~8K
LLM_TEMPERATURE=0.0               # Extraction default (deterministic)
LLM_CONVERSATION_TEMPERATURE=0.7  # Conversation default (Cluster 3 split)
LLM_CONVERSATION_MAX_TOKENS=1024  # Cluster 6 Bug E fix (was 400)

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# Knowledge Integration
# -----------------------------------------------------------------------------
ENABLE_KNOWLEDGE_INTEGRATION=true
ENABLE_VERSIONING=true
ENABLE_PROVENANCE=true
# Rebuild-determinism stamps (ADR-010 Phase 8 / C1).
#
# ONTOLOGY_VERSION and EXTRACTION_VERSION are deliberately absent and are NOT
# read from the environment. They describe CODE, so they are code-owned:
# the ontology stamp is derived from ONTOLOGY_V1_0_0.version and the
# extraction stamp lives in backend/knowledge/version_stamps.py, paired to the
# prompt content by a drift-guard test. Do not re-add them here -- an env pin
# is what let a deployment stamp a version the running code disagreed with,
# and extraction_cache keys on the triple, so disagreement is a hard cache
# miss rather than a mislabel.
#
# MIST_MODEL_HASH stays configurable: it names which model file is deployed,
# which genuinely varies per deployment.
MIST_MODEL_HASH=gemma-4-e4b-q5-k-m-carteakey-full-v1

# -----------------------------------------------------------------------------
# Persistent Data Paths (container mode)
# -----------------------------------------------------------------------------
# These override defaults that resolve to container-local paths.
# In native mode, comment these out to use defaults (~/.mist/, data/).
#
# Memory-store isolation for eval/gauntlet runs:
# EVENT_STORE_DB_PATH (here), MIST_VAULT_ROOT and MIST_SIDECAR_DB_PATH (in the
# Vault Memory section below) are the three live memory-store paths. docker-compose
# defaults them to the values shown via ${VAR:-default}, so they remain identical
# unless overridden. Before invoking a stack-backed eval driver
# (scripts/mist_admin.py replay/chat), set all three to a per-run throwaway dir to
# keep live memory untouched. See scripts/eval_harness/websocket_gauntlets_runbook.md
# ("Isolating eval runs from live memory").
EVENT_STORE_DB_PATH=/app/data/event_store.db
EVENT_STORE_AUDIO_DIR=/app/data/audio
VECTOR_STORE_DATA_DIR=/app/data/vector_store

# -----------------------------------------------------------------------------
# Voice Configuration
# -----------------------------------------------------------------------------
TTS_ENABLED=true
TTS_ENGINE=chatterbox
VOICE_PROFILE=friday

# -----------------------------------------------------------------------------
# TTS Configuration (Chatterbox Turbo)
# -----------------------------------------------------------------------------
TTS_EXAGGERATION=0.5
TTS_TEMPERATURE=0.8
TTS_CFG_WEIGHT=0.5

# -----------------------------------------------------------------------------
# Hugging Face Token (required for some model downloads)
# -----------------------------------------------------------------------------
# HF_TOKEN=hf_your_token_here

# -----------------------------------------------------------------------------
# Event Store (Layer 1)
# -----------------------------------------------------------------------------
EVENT_STORE_ENABLED=true
# EVENT_STORE_DB_PATH=       # Defaults to ~/.mist/event_store.db
# EVENT_STORE_AUDIO_DIR=     # Defaults to ~/.mist/audio/

# -----------------------------------------------------------------------------
# Auto-RAG Configuration
# -----------------------------------------------------------------------------
AUTO_INJECT_DOCS=true
AUTO_INJECT_LIMIT=3
AUTO_INJECT_THRESHOLD=0.4

# =============================================================================
# Knowledge System Enhancement Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Vector Store (K-02)
# -----------------------------------------------------------------------------
VECTOR_STORE_BACKEND=lancedb
VECTOR_STORE_DATA_DIR=data/vector_store
VECTOR_STORE_SIMILARITY_THRESHOLD=0.6
VECTOR_STORE_BATCH_SIZE=100
VECTOR_STORE_COLLECTION=mist_knowledge

# -----------------------------------------------------------------------------
# Ingestion Pipeline (K-03)
# -----------------------------------------------------------------------------
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=64
INGESTION_BATCH_SIZE=100
INGESTION_DEDUP_WINDOW_DAYS=30

# -----------------------------------------------------------------------------
# Extraction Config
# -----------------------------------------------------------------------------
EXTRACT_NODE_PROPERTIES=true
EXTRACT_REL_PROPERTIES=true
MIN_EXTRACTION_CONFIDENCE=0.5

# -----------------------------------------------------------------------------
# Extraction Enhancements (K-12)
# -----------------------------------------------------------------------------
SIGNIFICANCE_THRESHOLD=0.3
RATE_LIMIT_MAX_PER_MINUTE=30
DEDUP_SIMILARITY_THRESHOLD=0.95
DEDUP_CACHE_SIZE=200
DEDUP_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Query Intent / Hybrid Retrieval (K-07/K-08)
# -----------------------------------------------------------------------------
QUERY_HYBRID_THRESHOLD=0.4
QUERY_CONFIDENCE_BASE=0.5
QUERY_CONFIDENCE_PER_MATCH=0.1
QUERY_MIN_CONFIDENCE=0.3
RRF_K=15
RRF_VECTOR_WEIGHT=0.5
RRF_GRAPH_WEIGHT=0.5
MAX_VECTOR_RESULTS=20
MAX_GRAPH_RESULTS=20

# -----------------------------------------------------------------------------
# Vault Memory (Layer 2 - ADR-010 Cluster 8)
# -----------------------------------------------------------------------------
# Host bind mount target for the vault. Defaults to ./mist-memory at repo root.
# VAULT_HOST_PATH=./mist-memory
MIST_VAULT_ENABLED=true
# Eval-overridable (throwaway-trio member -- see Persistent Data Paths note above).
MIST_VAULT_ROOT=/app/mist-memory          # In-container path; matches volume mount
MIST_VAULT_DEFAULT_USER_ID=raj
MIST_VAULT_GIT_AUTO_INIT=true
MIST_VAULT_SESSION_SOFT_CAP_TURNS=20
MIST_VAULT_SESSION_SOFT_CAP_TOKENS=6000
# MIST_VAULT_APPEND_SENTINEL=<!-- MIST_APPEND_HERE -->
# MIST_VAULT_WRITER_QUEUE_MAX_DEPTH=100

# Sidecar index (sqlite-vec + FTS5 over vault chunks)
MIST_SIDECAR_ENABLED=true
# Eval-overridable (throwaway-trio member -- see Persistent Data Paths note above).
MIST_SIDECAR_DB_PATH=/app/data/vault_sidecar.db
MIST_SIDECAR_EMBEDDING_DIMENSION=384      # Must match EMBEDDING_DIMENSION
MIST_SIDECAR_HEADING_CONTEXT_WEIGHT=0.3
MIST_SIDECAR_CHUNK_MAX_CHARS=6000
MIST_SIDECAR_REBUILD_ON_STARTUP=false

# Filewatcher (watchdog observer for vault edits)
MIST_FILEWATCHER_ENABLED=true
MIST_FILEWATCHER_OBSERVER_TYPE=auto       # auto | polling | inotify | fsevents
MIST_FILEWATCHER_DEBOUNCE_MS=500
MIST_FILEWATCHER_STALENESS_SLO_SECONDS=5
# Audit cadence defaults to staleness_slo_seconds // 2; setting an explicit
# value permanently PINS the cadence and detaches it from the SLO.
# MIST_FILEWATCHER_AUDIT_INTERVAL_SECONDS=2

# -----------------------------------------------------------------------------
# Context Budget (Cluster 6)
# -----------------------------------------------------------------------------
# MIST_CTX_BUDGET_ENABLED=true
# MIST_CTX_BUDGET_WINDOW=8192
# MIST_CTX_BUDGET_OUTPUT_RESERVE=512
# MIST_CTX_BUDGET_SAFETY=256
# MIST_CTX_BUDGET_RETRIEVAL_RATIO=0.4
# MIST_CTX_BUDGET_HISTORY_STRATEGY=sliding_window

# -----------------------------------------------------------------------------
# Debug Observability (Cluster 5 / C2 -- all off by default)
# -----------------------------------------------------------------------------
# MIST_DEBUG_JSONL=/app/data/ingest/debug.jsonl
# MIST_DEBUG_LLM_JSONL=1
# MIST_DEBUG_RETRIEVAL_JSONL=1
# MIST_DEBUG_LLM_REQUESTS=1
# MIST_DEBUG_VAULT_JSONL=1
# MIST_DEBUG_RECONCILIATION_JSONL=1

# -----------------------------------------------------------------------------
# System Status (ADR-017 system_status emit)
# -----------------------------------------------------------------------------
# MIST_SYSTEM_STATUS_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# Skill Derivation (K-11)
# -----------------------------------------------------------------------------
SKILL_MIN_SESSION_USES=3
SKILL_WINDOW_SIZE=50
SKILL_CAPABILITY_THRESHOLD=5
SKILL_LOOKBACK_DAYS=7
SKILL_SIMILARITY_THRESHOLD=0.7
SKILL_DERIVATION_ENABLED=true
