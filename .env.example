# =============================================================================
# MIST.AI Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed.
#
# How values reach the backend process: docker-compose interpolates ${VAR}
# from .env for host-side concerns (ports, model files, bind mounts) AND
# loads this file into the mist-backend container via env_file, so every
# documented variable reaches the server process. Active (uncommented)
# values are kept in sync with the code defaults; commented entries document
# optional overrides.
#
# MIST_EVAL_ISOLATION is deliberately NOT listed here: it is per-run by
# design (the eval runbook passes it via `docker compose exec -e`); a
# standing value would force every backend run into eval mode.

# -----------------------------------------------------------------------------
# Neo4j Configuration
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://mist-neo4j:7687
# For native (non-Docker) mode: NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# LLM Backend
# -----------------------------------------------------------------------------
LLM_BACKEND=llamacpp              # "llamacpp" (llama-server) or "ollama" (fallback)
LLM_SERVER_URL=http://mist-llm:8080  # Docker internal URL
# For native (non-Docker) mode:
# LLM_SERVER_URL=http://localhost:8080
MODEL=gemma-4-e4b

# Model files (host paths)
MODELS_DIR=./models               # Host directory with GGUF files
LLM_MODEL_FILE=unsloth/gemma-4-E4B-it-Q5_K_M.gguf
LLM_CTX_SIZE=32768                # llama-server ctx; effective attention ~8K
LLM_CACHE_RAM_MIB=2048            # llama-server --cache-ram cap (MiB); default 8192 starved the VM
LLM_TEMPERATURE=0.0               # Extraction default (deterministic)
LLM_CONVERSATION_TEMPERATURE=0.7  # Conversation default (Cluster 3 split)
LLM_CONVERSATION_MAX_TOKENS=1024  # Cluster 6 Bug E fix (was 400)

# Conversation role (T39): the conversation's own llama-server and model.
# Unset means the conversation uses LLM_SERVER_URL and MODEL. Extraction and
# curation always use LLM_SERVER_URL and MODEL, whatever these say.
# MIST_LLM_CONVERSATION_URL takes an http or https URL. MIST_LLM_CONVERSATION_MODEL
# defaults to MODEL, and setting it without the URL fails at startup.
# MIST_LLM_CONVERSATION_URL=http://mist-llm-conversation:8080
# MIST_LLM_CONVERSATION_MODEL=gemma-4-e4b

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Device for every embedding model the backend builds: auto, cpu, cuda or
# cuda:<n>. auto lets sentence-transformers choose, which picks CUDA when
# present. Any other value stops the backend at boot. Gaming mode
# (MIST_OPS_DIR) needs cpu, so the embeddings take no GPU memory from a game.
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# Knowledge Integration
# -----------------------------------------------------------------------------
ENABLE_KNOWLEDGE_INTEGRATION=true
ENABLE_VERSIONING=true
ENABLE_PROVENANCE=true
# Rebuild-determinism stamps (ADR-010 Phase 8 / C1).
#
# ONTOLOGY_VERSION and EXTRACTION_VERSION are deliberately absent and are NOT
# read from the environment. They describe CODE, so they are code-owned:
# the ontology stamp is derived from ONTOLOGY_V1_0_0.version and the
# extraction stamp lives in backend/knowledge/version_stamps.py, paired to the
# prompt content by a drift-guard test. Do not re-add them here -- an env pin
# is what let a deployment stamp a version the running code disagreed with,
# and extraction_cache keys on the triple, so disagreement is a hard cache
# miss rather than a mislabel.
#
# MIST_MODEL_HASH stays configurable: it names which model file is deployed,
# which genuinely varies per deployment.
MIST_MODEL_HASH=gemma-4-e4b-q5-k-m-carteakey-full-v1

# -----------------------------------------------------------------------------
# Persistent Data Paths (container mode)
# -----------------------------------------------------------------------------
# These override defaults that resolve to container-local paths.
# In native mode, comment these out to use defaults (~/.mist/, data/).
#
# Memory-store isolation for eval/gauntlet runs:
# EVENT_STORE_DB_PATH (here), MIST_VAULT_ROOT and MIST_SIDECAR_DB_PATH (in the
# Vault Memory section below) are the three live memory-store paths. docker-compose
# defaults them to the values shown via ${VAR:-default}, so they remain identical
# unless overridden. Before invoking a stack-backed eval driver
# (scripts/mist_admin.py replay/chat), set all three to a per-run throwaway dir to
# keep live memory untouched. See scripts/eval_harness/websocket_gauntlets_runbook.md
# ("Isolating eval runs from live memory").
EVENT_STORE_DB_PATH=/app/data/event_store.db
EVENT_STORE_AUDIO_DIR=/app/data/audio
VECTOR_STORE_DATA_DIR=/app/data/vector_store

# -----------------------------------------------------------------------------
# Voice Configuration
# -----------------------------------------------------------------------------
# The realtime voice path (backend/realtime/) reads the voice settings below
# once at startup, in `load_voice_settings` (backend/realtime/budget.py);
# an invalid value stops the backend with a message naming the variable. Each
# is shown commented out at its default.

# The switch that turns spoken replies off: false answers voice turns in text
# only. Typed turns are never spoken. The engines still load (see the chains).
TTS_ENABLED=true
# Voice profile name. On the realtime path it selects the persona file
# voice_profiles/<profile>/personality.yaml (`PersonaRegister.load` in
# backend/server.py). The synthesis values in a profile's profile.yaml, such as
# exaggeration and cfg_weight, serve only the legacy src/multimodal voice path;
# the realtime engines do not read them, and they are not environment variables.
VOICE_PROFILE=mist

# --- Engines: each chain is comma-separated <engine>@<device> options, tried
# in order until one loads; `off` alone loads none. With the STT chain off, no
# VAD, end-of-turn model or name spotter loads either.
# MIST_VOICE_STT_CHAIN=nemotron-160@cuda,parakeet-cpu@cpu
# MIST_VOICE_TTS_CHAIN=pocket-clone@cpu
# Id of the voice identity TTS speaks, read from <identity root>/<id>/; unset
# names no identity.
# MIST_VOICE_TTS_VOICE=
# Root of the voice identities (the clips a voice is cloned from).
# MIST_VOICE_IDENTITY_ROOT=/voices
# Where artefacts built from a voice identity are cached.
# MIST_VOICE_CACHE_DIR=/voice-cache
# Root the speech model weights are read from.
# MIST_VOICE_MODELS_DIR=/models
# MiB of GPU memory the loaded speech engines should fit in; going over logs a
# warning and unloads nothing.
# MIST_VOICE_VRAM_BUDGET_MIB=4500
# Seconds a GPU release waits for running engine jobs to stop.
# MIST_VOICE_RELEASE_TIMEOUT_S=10.0

# --- Voice activity and end of turn
# VAD model, as <repo>@<revision>:<file>, and its device.
# MIST_VOICE_VAD_MODEL=onnx-community/silero-vad@e71cae966052b992a7eca6b17738916ce0eca4ec:onnx/model.onnx
# MIST_VOICE_VAD_DEVICE=cpu
# Speech probability at or above which a frame counts as speech.
# MIST_VOICE_VAD_THRESHOLD=0.5
# Silence, in ms, after speech before the end-of-turn model is asked.
# MIST_VOICE_ENDPOINT_SILENCE_MS=200
# End-of-turn model, as <repo>@<revision>:<file>, its device and threads.
# MIST_VOICE_EOT_MODEL=pipecat-ai/smart-turn-v3@f766f81d3cfdf7737ac64aad813d91bbfd56bf93:smart-turn-v3.2-cpu.onnx
# MIST_VOICE_EOT_DEVICE=cpu
# MIST_VOICE_EOT_THREADS=4
# End-of-turn probability at or above which the user is taken to be done.
# MIST_VOICE_EOT_THRESHOLD=0.5
# Silence, in ms, after which the turn ends whatever the model says.
# MIST_VOICE_EOT_MAX_SILENCE_MS=1500
# Send an end-of-turn candidate as soon as the final transcript is in, before
# the end of turn is decided.
# MIST_VOICE_SPECULATIVE_START=true
# A final transcript is dropped as non-speech when its no-speech probability is
# above the first and its mean log probability at or below the second.
# MIST_VOICE_NO_SPEECH_THRESHOLD=0.6
# MIST_VOICE_LOGPROB_THRESHOLD=-1.0

# --- Barge-in
# Words that stop MIST while she speaks.
# MIST_VOICE_BARGE_IN_KEYWORDS=stop,wait,hold on,cancel,never mind
# Ms after a turn's first audio reached the client before barge-in is armed.
# MIST_VOICE_BARGE_IN_ARM_DELAY_MS=1000
# A keyword heard in TTS text played within this many ms is ignored as echo.
# MIST_VOICE_ECHO_GUARD_MS=1500
# Ms in which wake reports from several endpoints are compared, and only the
# strongest answered.
# MIST_VOICE_WAKE_ARBITRATION_MS=250
# Words that also stop a ringing alarm; each must be a barge-in keyword.
# MIST_VOICE_ALARM_STOP_KEYWORDS=stop
# Ms a dispatched tool may still finish after its turn is cancelled.
# MIST_VOICE_TOOL_CANCEL_GRACE_MS=2000

# --- Wake by name
# Names the spotter listens for: lower-case single words.
# MIST_VOICE_WAKE_NAMES=mist
# Name spotter model id, read from <models dir>/speech/wake/<id>/ (unset: no
# server spotter), its CPU threads, and the score at or above which a name hit
# counts.
# MIST_VOICE_KWS_MODEL=
# MIST_VOICE_KWS_THREADS=1
# MIST_VOICE_KWS_THRESHOLD=0.5
# Score at or above which a client endpoint wake counts.
# MIST_VOICE_WAKE_ENDPOINT_THRESHOLD=0.5
# An endpoint wake with less audio than this, in ms, before it is rejected.
# MIST_VOICE_WAKE_ENDPOINT_MIN_BACKLOG_MS=1500
# How far back, in ms, a name hit's utterance may reach.
# MIST_VOICE_WAKE_LOOKBACK_MS=6000
# Longest speech gap, in ms, joined into one utterance.
# MIST_VOICE_WAKE_JOIN_GAP_MS=1000
# Ms past the hit the addressee gate decodes.
# MIST_VOICE_WAKE_GATE_TAIL_MS=300
# Ms the reference may lead a hit's window.
# MIST_VOICE_WAKE_REFERENCE_TOLERANCE_MS=400
# Ms MIST keeps listening without her name after a turn; 0 turns it off.
# MIST_VOICE_FOLLOWUP_WINDOW_MS=0
# Show `attend` at a name hit, before the addressee verdict.
# MIST_VOICE_WAKE_ATTEND_CUE=true
# File that replaces the addressee gate's word sets without a release; unset
# uses the built-in sets.
# MIST_VOICE_WAKE_PHRASES_FILE=

# --- Speaking
# Pass the spoken voice through the character stage.
# MIST_VOICE_CHARACTER=true
# Gain of the character stage's doubled voice.
# MIST_VOICE_CHARACTER_DOUBLE_GAIN=0.35
# Longest text segment, in characters, sent to TTS in one call.
# MIST_VOICE_MAX_SEGMENT_CHARS=200
# Audio, in ms, the client buffers before it starts playing.
# MIST_VOICE_CLIENT_PREBUFFER_MS=80
# Latency budget a turn is judged against: a preset (floor or memo), optionally
# followed by <row>=<ms> overrides, e.g. floor,stt_final_ms=300.
# MIST_VOICE_BUDGET=floor

# --- Voice turns' language model (read by LLMConfig, backend/knowledge/config.py)
# Thinking tokens a voice turn may spend; 0 turns thinking off.
# MIST_VOICE_THINKING_BUDGET_TOKENS=0
# Characters the first spoken segment waits for before it goes to TTS.
# MIST_VOICE_FIRST_SEGMENT_MIN_CHARS=40

# -----------------------------------------------------------------------------
# Hugging Face Token (required for some model downloads)
# -----------------------------------------------------------------------------
# HF_TOKEN=hf_your_token_here

# -----------------------------------------------------------------------------
# Event Store (Layer 1)
# -----------------------------------------------------------------------------
EVENT_STORE_ENABLED=true
# EVENT_STORE_DB_PATH=       # Defaults to ~/.mist/event_store.db
# EVENT_STORE_AUDIO_DIR=     # Defaults to ~/.mist/audio/

# -----------------------------------------------------------------------------
# Auto-RAG Configuration
# -----------------------------------------------------------------------------
AUTO_INJECT_DOCS=true
AUTO_INJECT_LIMIT=3
AUTO_INJECT_THRESHOLD=0.4

# =============================================================================
# Knowledge System Enhancement Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Vector Store (K-02)
# -----------------------------------------------------------------------------
VECTOR_STORE_BACKEND=lancedb
VECTOR_STORE_DATA_DIR=data/vector_store
VECTOR_STORE_SIMILARITY_THRESHOLD=0.6
VECTOR_STORE_BATCH_SIZE=100
VECTOR_STORE_COLLECTION=mist_knowledge

# -----------------------------------------------------------------------------
# Ingestion Pipeline (K-03)
# -----------------------------------------------------------------------------
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=64
INGESTION_BATCH_SIZE=100
INGESTION_DEDUP_WINDOW_DAYS=30

# -----------------------------------------------------------------------------
# Extraction Config
# -----------------------------------------------------------------------------
EXTRACT_NODE_PROPERTIES=true
EXTRACT_REL_PROPERTIES=true
MIN_EXTRACTION_CONFIDENCE=0.5

# -----------------------------------------------------------------------------
# Extraction Enhancements (K-12)
# -----------------------------------------------------------------------------
SIGNIFICANCE_THRESHOLD=0.3
RATE_LIMIT_MAX_PER_MINUTE=30
DEDUP_SIMILARITY_THRESHOLD=0.95
DEDUP_CACHE_SIZE=200
DEDUP_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Query Intent / Hybrid Retrieval (K-07/K-08)
# -----------------------------------------------------------------------------
QUERY_HYBRID_THRESHOLD=0.4
QUERY_CONFIDENCE_BASE=0.5
QUERY_CONFIDENCE_PER_MATCH=0.1
QUERY_MIN_CONFIDENCE=0.3
RRF_K=15
RRF_VECTOR_WEIGHT=0.5
RRF_GRAPH_WEIGHT=0.5
MAX_VECTOR_RESULTS=20
MAX_GRAPH_RESULTS=20

# -----------------------------------------------------------------------------
# Vault Memory (Layer 2 - ADR-010 Cluster 8)
# -----------------------------------------------------------------------------
# Host bind mount target for the vault. Defaults to ./mist-memory at repo root.
# VAULT_HOST_PATH=./mist-memory
MIST_VAULT_ENABLED=true
# Eval-overridable (throwaway-trio member -- see Persistent Data Paths note above).
MIST_VAULT_ROOT=/app/mist-memory          # In-container path; matches volume mount
MIST_VAULT_DEFAULT_USER_ID=raj
MIST_VAULT_GIT_AUTO_INIT=true
MIST_VAULT_SESSION_SOFT_CAP_TURNS=20
MIST_VAULT_SESSION_SOFT_CAP_TOKENS=6000
# MIST_VAULT_APPEND_SENTINEL=<!-- MIST_APPEND_HERE -->
# MIST_VAULT_WRITER_QUEUE_MAX_DEPTH=100

# Sidecar index (sqlite-vec + FTS5 over vault chunks)
MIST_SIDECAR_ENABLED=true
# Eval-overridable (throwaway-trio member -- see Persistent Data Paths note above).
MIST_SIDECAR_DB_PATH=/app/data/vault_sidecar.db
MIST_SIDECAR_EMBEDDING_DIMENSION=384      # Must match EMBEDDING_DIMENSION
MIST_SIDECAR_HEADING_CONTEXT_WEIGHT=0.3
MIST_SIDECAR_CHUNK_MAX_CHARS=6000
MIST_SIDECAR_REBUILD_ON_STARTUP=false

# Filewatcher (watchdog observer for vault edits)
MIST_FILEWATCHER_ENABLED=true
MIST_FILEWATCHER_OBSERVER_TYPE=auto       # auto | polling | inotify | fsevents
MIST_FILEWATCHER_DEBOUNCE_MS=500
MIST_FILEWATCHER_STALENESS_SLO_SECONDS=5
# Audit cadence defaults to staleness_slo_seconds // 2; setting an explicit
# value permanently PINS the cadence and detaches it from the SLO.
# MIST_FILEWATCHER_AUDIT_INTERVAL_SECONDS=2

# -----------------------------------------------------------------------------
# Context Budget (Cluster 6 / MIS-171 T4)
# -----------------------------------------------------------------------------
# MIST_CTX_BUDGET_ENABLED=true
# MIST_CTX_BUDGET_WINDOW=auto        # "auto" (default) reads llama-server's real
                                      # n_ctx from GET /props at startup, falling
                                      # back to LLM_CTX_SIZE (or 32768) if
                                      # unreachable. An explicit int always wins.
                                      # Recommended: MIST_CTX_BUDGET_WINDOW=8192 on
                                      # any instance serving Gemma 4 E4B, which
                                      # degrades past about 8K while "auto" reads
                                      # the 32768 n_ctx (adopted 2026-10-23).
# MIST_CTX_BUDGET_OUTPUT_RESERVE=512
# MIST_CTX_BUDGET_SAFETY=256
# MIST_CTX_BUDGET_RETRIEVAL_RATIO=0.4
# MIST_CTX_BUDGET_HISTORY_STRATEGY=stable_window   # stable_window | sliding_window.
                                      # stable_window moves the history window's
                                      # start in steps so consecutive prompts
                                      # share a prefix llama-server can reuse.
# MIST_CTX_BUDGET_HISTORY_HIGH_WATER=2.0   # stable_window grows to this multiple
                                      # of the history cap before stepping;
                                      # at least 1.0.
# MIST_CTX_BUDGET_TURN_DELTA_MAX_TOKENS=1000   # token cap for the per-turn
                                      # context (retrieval, advisory, notes).
# MIST_CTX_BUDGET_DELTA_PLACEMENT=user_prefix   # user_prefix (in the final user
                                      # message) | system_tail (a system message
                                      # just before it).

# MIS-171 T4 decision 6: thinking budget for tool-dispatch turns (LLMRequest.tools
# set, no caller-set thinking). "off" disables the wrapper entirely.
# MIST_TOOL_THINKING_BUDGET=1024

# -----------------------------------------------------------------------------
# Memory Read Path (backend/memory, mist-read-path)
# -----------------------------------------------------------------------------
# Each line shows the default. A blank value counts as unset.
# false restores the legacy vault-only auto-inject.
# MIST_MEMORY_ENABLED=true
# Token budget of the memory block; the handler lowers it per turn to the
# planner's retrieval allowance when that is smaller.
# MIST_MEMORY_BLOCK_TOKENS=500
# Share of the block reserved for episodes and exchanges on a temporal or
# conversation-start turn; unused reserve flows back.
# MIST_MEMORY_CONTINUITY_SHARE=0.35
# Candidates selected by rank, 1-25 and at most MIST_MEMORY_RERANK_TOP_N; a
# facet counts as one. No run chose the default (H18, 16 Nov, ran no setting);
# it ships as built.
# MIST_MEMORY_SELECT_K=8
# Critical-path budget of each fetch, in ms, including any wait on stage 1.
# MIST_MEMORY_DEADLINE_MS=50
# local (cross-encoder in-process) | remote (HTTP rerank server) | off
# MIST_MEMORY_RERANK_BACKEND=local
# For local: model path, pair ceiling and device (cpu | cuda).
# MIST_MEMORY_RERANK_MODEL=/opt/models/ms-marco-MiniLM-L-6-v2
# MIST_MEMORY_RERANK_TOP_N=20
# MIST_MEMORY_RERANK_DEVICE=cpu
# For remote: the server's base URL (required), the model name it expects
# (optional), the timeout in ms (capped at the deadline left), and whether it
# returns logit or probability scores.
# MIST_MEMORY_RERANK_URL=
# MIST_MEMORY_RERANK_REMOTE_MODEL=
# MIST_MEMORY_RERANK_TIMEOUT_MS=40
# MIST_MEMORY_RERANK_REMOTE_SCORES=logit
# Derived index file. Unset means memory_index.db beside the event store
# (":memory:" when the event store is in memory).
# MIST_MEMORY_INDEX_PATH=
# Minimum seconds between two index refreshes.
# MIST_MEMORY_REFRESH_DEBOUNCE_S=30
# Block budget at the low serving level, 0-300 (0 sends no block at low).
# MIST_MEMORY_BLOCK_TOKENS is the budget at full; off sends none.
# MIST_MEMORY_BLOCK_TOKENS_LOW=0
# Most facts one list item, or one facet's expansion, brings into the block, 2-25.
# MIST_MEMORY_LIST_MAX_ITEMS=25
# Facets (a subject, relation and object type held by two or more facts) as
# candidates, served as their current members: on | off.
# MIST_MEMORY_FACETS=on
# Seconds between two rescans of the graph for changed facts, at least 30.
# MIST_MEMORY_RESCAN_INTERVAL_S=300
# Fact view the index embeds: F0 (the served sentence), F1 (second person for
# the user), F2 (F1 plus the object's type word), F3 (F2 without the dates).
# A change re-embeds the changed rows at the next rescan.
# MIST_MEMORY_FACT_VIEW=F3
# Need gate: on (each fetch asks how likely the turn needs memory and closes,
# cuts or opens the fetch), shadow (decides and traces, then serves the fetch
# as open), off (no gate; nothing reads the need bank or the gate model file,
# the rollback lever when either is what broke). off is the default: with the
# gate in shadow, 121 of 178 dev idle fetches at H4 (17 Nov) missed their
# deadline, against none with it off, and the shipped gate model is shadow-only,
# fit when no gate met the eligibility rule.
# MIST_MEMORY_NEED_GATE=off
# Gate embedder: shared (reuses the fetch's own query vector),
# bge-small-en-v1.5 or granite-embedding-small-english-r2 (embed the query a
# second time on the memory-gate thread). The gate model file must hold a
# record fit for the chosen embedder.
# MIST_MEMORY_NEED_EMBEDDER=shared
# Judge a closed or band query that follows a fetch which served memory also by
# the previous user turn joined to it, taking the higher probability.
# MIST_MEMORY_NEED_CONTEXT=true
# Corrections (forget and correct): the fetch reads the correction log and
# leaves out the facts and notes a correction names. false stops the
# suppression; the recorded corrections stay in the log.
# MIST_MEMORY_CORRECTIONS_ENABLED=true
# Phrases such as "yesterday" are read in MIST_TIMEZONE (Daily Instance below).
# The block's placement follows MIST_CTX_BUDGET_DELTA_PLACEMENT. The retired
# MIST_MEMORY_BLOCK_ROLE and MIST_MEMORY_TZ fail startup when set.

# -----------------------------------------------------------------------------
# Debug Observability (Cluster 5 / C2 -- all off by default)
# -----------------------------------------------------------------------------
# MIST_DEBUG_JSONL=/app/data/ingest/debug.jsonl
# MIST_DEBUG_LLM_JSONL=1
# MIST_DEBUG_RETRIEVAL_JSONL=1
# MIST_DEBUG_LLM_REQUESTS=1
# MIST_DEBUG_VAULT_JSONL=1
# MIST_DEBUG_RECONCILIATION_JSONL=1

# -----------------------------------------------------------------------------
# System Status (ADR-017 system_status emit)
# -----------------------------------------------------------------------------
# MIST_SYSTEM_STATUS_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# Daily Instance (backend)
# -----------------------------------------------------------------------------
# Browser origins allowed to call the HTTP routes (CORS) and to open /ws,
# comma-separated. A value replaces the default list rather than adding to it;
# matching is exact after lowercasing. `*` allows every origin. A client that
# sends no Origin header (a local program, not a browser page) is always
# allowed. A refused WebSocket is closed with 1008 and logged at WARNING as
# "WebSocket refused origin: <origin>". Blank or unset, the default is:
# MIST_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:1420,http://127.0.0.1:1420

# IANA time zone of MIST's local days: the days GET /usage/turns-per-day counts
# real-origin turns on, the days GET /usage/uptime sums its seconds over, and
# the dates the memory read path reads phrases such as "yesterday" in.
# Default: UTC, with one startup warning. An unknown name is logged, and both
# endpoints use UTC and say so; the memory read path refuses to start on it.
# MIST_TIMEZONE=<iana-timezone>

# Seconds between the uptime ledger's samples of the /health status, which
# GET /usage/uptime reports per local day (in MIST_TIMEZONE). A silence
# longer than 2.5 periods is left unrecorded. A value that is not a positive
# number is logged and replaced by the default. Default: 60.
# MIST_UPTIME_RECORD_S=60

# /health thresholds and inputs. A malformed or non-positive age is logged and
# replaced by its default rather than stopping the backend.
# Age in seconds of the oldest pending extraction turn past which the
# extraction_backlog check reads backlog_overdue. Default: 21600 (6 hours).
# MIST_HEALTH_BACKLOG_MAX_AGE_S=21600
# The backup scheduler's status file, which /health's backup check reads.
# Unset, backups count as not configured here and that check reports null.
# MIST_BACKUP_STATUS_PATH=<path-to-backup-status-file>
# Age in hours of the last successful backup past which the backup check reads
# down. Default: 26 (the daily interval plus two hours of slack).
# MIST_BACKUP_MAX_AGE_HOURS=26

# Ops directory the backend reads the gaming-mode marker from (written by the
# daily instance CLI). Setting it turns gaming mode on: while
# <MIST_OPS_DIR>/gpu-yielded exists the backend releases its GPU speech
# engines (`release_gpu_engines`, backend/realtime/runtime.py), tells turns
# that need the language model that the GPU is yielded
# (`gpu_yield_refusal`, backend/realtime/power.py), reports the llm check as
# yielded, and defers the self_reflection curation job.
# Unset, there is no gaming mode: the backend never yields the GPU.
# MIST_OPS_DIR=<path-to-ops-dir>

# Seconds between the backend's checks for the gaming-mode marker. A value
# that is not a positive number is logged and replaced by the default.
# Default: 2.
# MIST_GPU_YIELD_POLL_S=2

# Registry of live instance roots, one absolute path per line, written by the
# daily instance CLI. The isolation guard (backend/knowledge/eval_isolation.py)
# treats each listed root as live state, so backup destinations, restore
# targets and hydration refuse it. An unreadable registry refuses every guarded
# path. Default: ~/.mist/live-instances. Blank counts as unset.
# MIST_LIVE_INSTANCES_FILE=<path-to-live-instances-file>

# Rotation of the backend log file (mist-backend.log in MIST_LOG_DIR). A value
# that is not a positive integer is logged and replaced by its default.
# Size in bytes at which the log rotates. Default: 52428800 (50 MiB).
# MIST_LOG_MAX_BYTES=52428800
# Number of rotated files kept (mist-backend.log.1 onwards). Default: 5.
# MIST_LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Extraction Service (MIS-171 two-loop)
# -----------------------------------------------------------------------------
# "service" dispatches turns to the extraction service; "off" logs turns and
# dispatches nothing (state `disabled`). Default: service.
# MIST_EXTRACTION_INFERENCE=service
# Root URL of the extraction service. Default: http://mist-extraction:8090
# (DispatcherSettings.DEFAULT_SERVICE_URL) -- the local compose DNS name an
# extraction-local deployment reaches. A host deployment (see
# docker/extraction/HOST_1070_RUNBOOK.md) instead points this at the
# Tailscale hostname, e.g. http://mist-extraction-gtx1070:8090.
# MIST_EXTRACTION_SERVICE_URL=http://mist-extraction:8090
# Per-LLM-call timeout, in seconds, for the extraction service's own
# llama-server calls. Default: 120. Forwarded to the container by both
# docker-compose.extraction.yml (local) and docker/extraction/compose.host.yml
# (host); set it in the deployment's own .env, not here (see
# docker/extraction/HOST_1070_RUNBOOK.md for the host's .env).
# EXTRACTION_LLM_TIMEOUT_SECONDS=120
# Maximum extraction attempts per job (the first call plus repair retries on
# unparsable output). Default: 2. Forwarded to the container by both
# docker-compose.extraction.yml (local) and docker/extraction/compose.host.yml
# (host).
# EXTRACTION_MAX_ATTEMPTS=2
# Overrides the model adapter's default constrained-decoding mode
# (schema/json_object/none) when set. Default: empty, which falls through to
# the adapter's own default. Forwarded to the container by both
# docker-compose.extraction.yml (local) and docker/extraction/compose.host.yml
# (host).
# EXTRACTION_CONSTRAINED_MODE=
# The GPU the extraction llama-server runs on, e.g. rtx-4070-super (local) or
# gtx-1070 (host). Required, no default: both compose files fail
# `docker compose config` without it, like EXTRACTION_MODEL_HASH. It reaches the
# service as EXTRACTION_SERVER_DEVICE and keys the extraction epoch, so the two
# GPUs never share one. Set it in the deployment's own .env.
# EXTRACTION_LLM_DEVICE=rtx-4070-super
# The EXTRACTION_SERVER_* family (EXTRACTION_SERVER_IMAGE, _DEVICE, _CTX_SIZE,
# _N_CPU_MOE, ...) is not set here. Each compose file builds it from the same
# expression as the llama-server flag it declares, for example
# EXTRACTION_SERVER_CTX_SIZE=${EXTRACTION_LLM_CTX_SIZE:-16384}, so set the source
# variable (EXTRACTION_LLM_CTX_SIZE, EXTRACTION_LOCAL_NCMOE, EXTRACTION_HOST_NCMOE,
# LLM_CACHE_RAM_MIB) instead. Changing any of them starts a new extraction epoch:
# see docker/extraction/README.md, "Declared llama-server settings".

# -----------------------------------------------------------------------------
# Skill Derivation (K-11)
# -----------------------------------------------------------------------------
SKILL_MIN_SESSION_USES=3
SKILL_WINDOW_SIZE=50
SKILL_CAPABILITY_THRESHOLD=5
SKILL_LOOKBACK_DAYS=7
SKILL_SIMILARITY_THRESHOLD=0.7
SKILL_DERIVATION_ENABLED=true

# -----------------------------------------------------------------------------
# Capabilities (alarms, timers, clock, lights, music)
# -----------------------------------------------------------------------------
# Off by default. While MIST_ALLOWED_ORIGINS (Daily Instance, above) allows
# every origin with `*`, or eval or hydration isolation is active, no capability
# host is built and GET /capabilities reports why. Alarms and timers need
# MIST_TIMEZONE (Daily Instance, above): with it unset or unknown they report
# unavailable and nothing rings.
MIST_CAPABILITIES_ENABLED=false
# Comma-separated subset of clock,alarms,timers,lights,music. Default: all five.
# MIST_CAPABILITIES=clock,alarms,timers,lights,music
# Host address compose publishes port 8001 on. Default 127.0.0.1, so other hosts
# on the LAN cannot reach a backend that can switch lights and music; 0.0.0.0
# publishes it on every interface.
# MIST_BACKEND_BIND_ADDR=127.0.0.1
# SQLite file for alarms, timers and the action log. Compose sets the container
# path /app/data/capabilities.db, on the ./data bind mount.
# MIST_CAPABILITIES_DB_PATH=data/capabilities.db
# Optional YAML override of the per-tool confirmation policy. A file that does
# not load is logged and the built-in policy applies.
# MIST_CAPABILITY_POLICY_FILE=data/capability_policy.yaml

# Seconds one tool call may take before it reports a timeout. Default: 8.
# MIST_CAPABILITY_TOOL_TIMEOUT_S=8
# Seconds a proposed action waits for confirmation. Default: 60.
# MIST_CAPABILITY_PROPOSAL_TTL_S=60
# Token ceiling on the decode prompt: the capability catalog plus its
# instructions. Default: 1200.
# MIST_CAPABILITY_TOOL_TOKEN_BUDGET=1200
# Resolve a command that exactly one capability's grammar matches without the
# model. Default: true.
# MIST_CAPABILITY_FAST_PATH=true
# Seconds the model may take to decode an action. Default: 10.
# MIST_CAPABILITY_DECODE_TIMEOUT_S=10
# Comma-separated leading words stripped from an utterance before matching.
# MIST_CAPABILITY_WAKE_WORDS=mist,hey mist,ok mist,okay mist
# How many of the session's last turns keep their capabilities routed. Default: 2.
# MIST_CAPABILITY_ROUTER_STICKY_TURNS=2
# Similarity threshold (0..1) for the router's embedding stage. Unset: the stage
# is off. The backend does not yet wire an embedder, so a value here is logged
# and the stage stays off.
# MIST_CAPABILITY_ROUTER_EMBEDDING_THRESHOLD=

# Alarms. Seconds an alarm rings before it stops on its own (default 600);
# minutes a snooze lasts (1..60, default 9); seconds past its time an alarm
# may still ring before it counts as missed (default 900, never under 60).
# MIST_ALARM_RING_TIMEOUT_S=600
# MIST_ALARM_SNOOZE_MINUTES=9
# MIST_ALARM_MISSED_GRACE_S=900
# Seconds an endpoint that cannot reach the backend waits past an alarm's time
# before it rings on its own (5..300, default 30). Must be below the grace
# window above, which is never under 60 s.
# MIST_RING_FALLBACK_AFTER_S=30

# Lights, through Home Assistant's MCP server. Lights is built only when the URL
# is set. Give the token directly or as a file path; it is redacted from logs
# and never returned by GET /capabilities.
# MIST_HA_MCP_URL=<home-assistant-mcp-server-url>
# MIST_HA_TOKEN=<home-assistant-long-lived-token>
# MIST_HA_TOKEN_FILE=<path-to-file-holding-the-token>
# Light or area a command without a target applies to.
# MIST_LIGHTS_DEFAULT_TARGET=<light-or-area-name>

# Music, through Spotify's Web API (PKCE, no client secret). Music is built only
# when the client id is set. The token file holds the refresh token: keep it
# under data/secrets/, which is gitignored. Compose sets the container path
# /app/data/secrets/spotify_token.json.
# MIST_SPOTIFY_CLIENT_ID=<spotify-client-id>
# MIST_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# MIST_SPOTIFY_TOKEN_PATH=data/secrets/spotify_token.json
# Device name to play on when no Spotify device is active.
# MIST_SPOTIFY_DEVICE=<spotify-device-name>
