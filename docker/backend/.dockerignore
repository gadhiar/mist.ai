# Docker build context exclusions
# NOT consulted by `docker build`: the backend service's build context
# (docker-compose.yml, mist-backend) is the project root (.), and Docker
# only reads a `.dockerignore` at the root of the build context (or a
# Dockerfile-specific `<dockerfile>.dockerignore` next to the Dockerfile,
# which this is not). Because the build context is the project root, this
# file -- living at docker/backend/ -- is exactly where Docker does NOT
# look; it is inert. The operative dockerignore for the backend build is
# the root `.dockerignore`. This file is left in place as human-readable
# documentation of intent, not because Docker reads it.

# Python virtual environments (~10-20GB each)
venv/
venv-chatterbox/
.venv/

# Git
.git/

# CSM training data, models, caches, and test outputs (~180GB)
dependencies/csm/audio_data*/
dependencies/csm/finetuned_model*/
dependencies/csm/hf_cache/
dependencies/csm/jarvis_test_outputs/
dependencies/csm/test_output/
*.wav
*.safetensors
*.bin
*.pt
!data/voice_profiles/**/*.yaml

# Data directories (mounted at runtime, not baked into image)
data/vector_store/
data/chatterbox_eval/

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE and tools
.claude/
.cursor/
.vscode/
.idea/
*.swp
*.swo

# Environment files (injected via compose)
.env
.env.local

# Documentation and specs (not needed at runtime)
docs/
knowledge-vault/

# Docker files themselves
docker/

# Node artifacts
node_modules/
