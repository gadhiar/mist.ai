# Tauri frontend lives in mist-frontend/ as a nested git repo
# (its own .git, branches, history). Outer mist.ai/ does not track its
# contents. To work on the frontend: cd mist-frontend && git status.
mist-frontend/

# Docs
docs/

# Claude Code
.claude/
CLAUDE.md
CODEBASE.md

# Local scratch workspace (mirrored plans, exploratory artifacts)
.local/

# Runtime data artifacts (event store SQLite, graph snapshots, ingest workspace,
# replay/runtime scratch, and timestamped pre-op backups)
data/event_store.db
data/event_store.db-shm
data/event_store.db-wal
data/extraction_cache.db
data/extraction_cache.db-shm
data/extraction_cache.db-wal
data/graph_snapshots/
data/ingest/
data/runtime/
data/eval-run/
data/*-backup-*

# R1.4.6 hydration. `dev-state/` is the dev profile's live-ish store root (the
# ONLY writable mount of mist-backend-dev); `data/hydration-snapshots/` holds
# the versioned artifacts snapshot.py dumps out of it. Both are regenerable --
# dev-state by restore, the artifacts by a hydration run -- and both contain
# SQLite/vault state that must never enter git history.
dev-state/
data/hydration-snapshots/
