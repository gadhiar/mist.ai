# Docker build context exclusions
# The build context is the project root (.), so this file must be here.

# Python virtual environments (~10-20GB each)
venv/
venv-chatterbox/
.venv/

# Git
.git/

# CSM training data, models, caches, and test outputs (~180GB)
dependencies/csm/audio_data*/
dependencies/csm/finetuned_model*/
dependencies/csm/hf_cache/
dependencies/csm/jarvis_test_outputs/
dependencies/csm/test_output/
*.wav
*.safetensors
*.bin
*.pt
!data/voice_profiles/**/*.yaml

# Data directories (mounted at runtime, not baked into image)
data/vector_store/
data/chatterbox_eval/

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE and tools
.claude/
.cursor/
.vscode/
.idea/
*.swp
*.swo

# Environment files (injected via compose)
.env
.env.local

# Documentation and specs (not needed at runtime)
docs/
knowledge-vault/

# Docker files themselves
docker/
# Chained re-include: `docker/` above excludes this whole tree, so
# `!docker/extraction/` un-excludes the directory itself (so Docker's
# build-context walker descends into it and evaluates further patterns),
# `docker/extraction/*` re-excludes everything directly inside it, and
# `!docker/extraction/requirements.txt` re-includes just that one file --
# the extraction Dockerfile's `COPY docker/extraction/requirements.txt`
# needs it to survive the `docker/` exclusion above. Only this one file and
# the `docker/extraction/` directory entry itself survive; everything else
# under `docker/`, including the rest of `docker/extraction/` (Dockerfile,
# README.md, the host `.env`), stays excluded.
!docker/extraction/
docker/extraction/*
!docker/extraction/requirements.txt

# Node artifacts
node_modules/
