# MIST.AI daily instance environment: copy to <instance root>/daily.env and fill in.
#
# One file serves two readers. The instance CLI passes it to compose as --env-file, which resolves
# every ${VAR} in deploy/daily/compose.yml, and compose hands it to mist-backend as its env_file.
# The compose file's environment literals win over any line here, so this file cannot move a
# store, turn TTS on or put the embedding model on the GPU.
#
# Values in <angle brackets> are placeholders. A commented-out line shows the default that
# applies when it stays commented out. daily.env holds a secret and host paths: never commit it.

# --- Release and instance ---

# Release tag of the mist-backend image to run; `instance.py switch` rewrites this line.
MIST_RELEASE_TAG=<release-tag>
# Absolute path of the instance root on the host, outside every git work tree.
MIST_DAILY_ROOT=<absolute-path-to-instance-root>
# Instance name, as recorded in the root's .mist-live-instance marker.
MIST_INSTANCE_NAME=<instance-name>

# --- Neo4j ---

# Neo4j user name.
# NEO4J_USERNAME=neo4j
# Neo4j password, read by Neo4j, the backend and the backup service.
NEO4J_PASSWORD=<neo4j-password>
# Name of the existing Docker volume that holds the graph; external, so `down -v` keeps it.
MIST_DAILY_NEO4J_VOLUME=<neo4j-data-volume-name>
# Neo4j heap size, used for both the initial and the maximum heap.
# MIST_DAILY_NEO4J_HEAP=1g
# Neo4j page-cache size.
# MIST_DAILY_NEO4J_PAGECACHE=512m

# --- LLM ---

# Absolute path of the host directory holding the llama-server model files, mounted read-only.
MODELS_DIR=<absolute-path-to-models>
# Model file under MODELS_DIR that llama-server loads.
# LLM_MODEL_FILE=unsloth/gemma-4-E4B-it-Q5_K_M.gguf
# llama-server context size in tokens.
# LLM_CTX_SIZE=32768
# llama-server prompt-cache cap in MiB.
# LLM_CACHE_RAM_MIB=2048
# Model name the backend reads (backend/knowledge/config.py); the code default applies if unset.
# MODEL=<model-id>
# Name of the external Docker network a dev stack joins to reach mist-llm.
# MIST_LLM_SHARE_NETWORK=mist-llm-share

# --- Backend ---

# Comma-separated browser origins allowed to open the WebSocket; replaces the default list.
# MIST_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Extraction mode, service or off; the code default is service.
# MIST_EXTRACTION_INFERENCE=<service-or-off>
# URL of the extraction service; while it is unreachable, turns queue in the backlog.
# MIST_EXTRACTION_SERVICE_URL=<extraction-service-url>
# IANA time zone that bounds the local days of the use counts; UTC when unset.
# MIST_USAGE_TIMEZONE=<iana-timezone>

# --- Backups ---

# Absolute host path of the backup destination, outside the instance root and every work tree.
MIST_BACKUP_HOST_PATH=<absolute-path-to-backup-destination>
# Hours between successful backups.
# MIST_BACKUP_INTERVAL_HOURS=24
# Number of successful backups prune keeps.
# MIST_BACKUP_RETAIN=7
# Minutes between checks whether a backup is due.
# MIST_BACKUP_CHECK_MINUTES=10
# Minutes before a failed backup is retried.
# MIST_BACKUP_RETRY_MINUTES=60
# Least fraction of the last success's graph nodes a new backup must hold to count as a success.
# MIST_BACKUP_MIN_NODE_RATIO=0.5

# --- Memory limits (unmeasured estimates; check them against `docker stats`) ---

# Memory limit of mist-backend.
# MIST_DAILY_BACKEND_MEM_LIMIT=8g
# Memory limit of mist-neo4j; above its heap plus page cache.
# MIST_DAILY_NEO4J_MEM_LIMIT=2g
# Memory limit of mist-llm; above the prompt-cache cap.
# MIST_DAILY_LLM_MEM_LIMIT=4g
# Memory limit of mist-backup.
# MIST_DAILY_BACKUP_MEM_LIMIT=4g

# --- Ports (rehearsal only) ---
# The daily instance keeps the canonical ports, and `instance.py up` refuses any other for an
# instance named daily. Set these only for a rehearsal instance beside a running one.

# Rehearsal only: host port of the backend WebSocket.
# MIST_DAILY_WS_PORT=8001
# Rehearsal only: host port of Neo4j Bolt.
# MIST_DAILY_BOLT_PORT=7687
# Rehearsal only: host port of the Neo4j HTTP browser.
# MIST_DAILY_NEO4J_HTTP_PORT=7474
