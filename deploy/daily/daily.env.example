# MIST.AI daily instance environment: copy to <instance root>/daily.env and fill in.
#
# One file serves two readers. The instance CLI passes it to compose as --env-file, which resolves
# every ${VAR} in deploy/daily/compose.yml, and compose hands it to mist-backend as its env_file.
# The compose file's environment literals win over any line here, so this file cannot move a
# store or put the embedding model on the GPU.
#
# Values in <angle brackets> are placeholders. A commented-out line shows the default that
# applies when it stays commented out. daily.env holds a secret and host paths: never commit it.

# --- Release and instance ---

# Release tag of the mist-backend image to run; `instance.py switch` rewrites this line.
MIST_RELEASE_TAG=<release-tag>
# Absolute path of the instance root on the host, outside every git work tree.
MIST_DAILY_ROOT=<absolute-path-to-instance-root>
# Instance name, as recorded in the root's .mist-live-instance marker.
MIST_INSTANCE_NAME=<instance-name>

# --- Neo4j ---

# Neo4j user name.
# NEO4J_USERNAME=neo4j
# Neo4j password, read by Neo4j, the backend and the backup service.
NEO4J_PASSWORD=<neo4j-password>
# Name of the existing Docker volume that holds the graph; external, so `down -v` keeps it.
MIST_DAILY_NEO4J_VOLUME=<neo4j-data-volume-name>
# Neo4j heap size, used for both the initial and the maximum heap.
# MIST_DAILY_NEO4J_HEAP=1g
# Neo4j page-cache size.
# MIST_DAILY_NEO4J_PAGECACHE=512m

# --- LLM ---

# Absolute path of the host directory holding the llama-server model files and the speech
# weights, mounted read-only at /models in mist-llm, mist-extraction-llm and mist-backend.
MODELS_DIR=<absolute-path-to-models>
# Model file under MODELS_DIR that llama-server loads.
# LLM_MODEL_FILE=unsloth/gemma-4-E4B-it-Q5_K_M.gguf
# llama-server context size in tokens.
# LLM_CTX_SIZE=32768
# llama-server prompt-cache cap in MiB.
# LLM_CACHE_RAM_MIB=2048
# Model name the backend reads (backend/knowledge/config.py); the code default applies if unset.
# MODEL=<model-id>
# Name of the external Docker network a dev stack joins to reach mist-llm.
# MIST_LLM_SHARE_NETWORK=mist-llm-share

# --- Backend ---

# Comma-separated browser origins allowed to open the WebSocket; replaces the default list.
# MIST_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Compose sets MIST_EXTRACTION_INFERENCE and MIST_EXTRACTION_SERVICE_URL on mist-backend, to
# the service mode and mist-extraction in this project; a line here for either is ignored.
# Age in seconds of the oldest pending turn past which /health reads the backlog as overdue.
# MIST_HEALTH_BACKLOG_MAX_AGE_S=86400
# IANA time zone of MIST's local days, for the use counts and the uptime ledger; UTC when unset.
# Alarms, timers and the clock also ring and read in it, and stay unavailable while it is unset.
# MIST_TIMEZONE=<iana-timezone>

# --- Voice ---
# Voice runs on the code's defaults (backend/realtime/budget.py) until a line below changes one;
# `instance.py up` applies a changed line. The speech weights are read from MODELS_DIR.

# Speech-to-text engines in the order they are tried: comma-separated <engine>@<device>
# options, with cpu or cuda as the device. `off` alone turns the slot off, which is the
# behaviour rollback. Her voice identities live in <MIST_DAILY_ROOT>/voices/, outside every
# repository.
# MIST_VOICE_STT_CHAIN=<stt-chain>
# Engines for spoken replies, in the same form; `off` alone turns the slot off.
# MIST_VOICE_TTS_CHAIN=<tts-chain>
# Voice identity id: a directory under <MIST_DAILY_ROOT>/voices/. No identity when unset.
# MIST_VOICE_TTS_VOICE=<voice-identity-id>
# Wake model id, read from speech/wake/<id>/ under MODELS_DIR; the server spotter is off when
# unset.
# MIST_VOICE_KWS_MODEL=<wake-model-id>
# Score from 0 to 1 at or above which a heard name counts; 0.5 when unset.
# MIST_VOICE_KWS_THRESHOLD=<probability>
# JSON file of wake phrases and addressee word sets; the built-in sets apply when unset. The
# file lives under MODELS_DIR, because only `/models` is mounted for it, so its path starts
# with /models.
# MIST_VOICE_WAKE_PHRASES_FILE=/models/speech/wake/phrases.json

# --- Capabilities ---
# Off until MIST_CAPABILITIES_ENABLED is true; `instance.py up` applies a changed line. The
# store and token paths are compose literals: the Home Assistant token goes in
# <root>/secrets/ha_token, and the Spotify token is written to <root>/secrets/spotify_token.json.

# Turns the capability host on: true or false, false when unset.
# MIST_CAPABILITIES_ENABLED=<true-or-false>
# Comma-separated capabilities to run, from clock, alarms, timers, lights and music; all five
# when unset.
# MIST_CAPABILITIES=<capability-list>
# URL of the Home Assistant MCP server that lights use.
# MIST_HA_MCP_URL=<ha-mcp-url>
# Light or area that lights use when a command names none.
# MIST_LIGHTS_DEFAULT_TARGET=<area-name>
# Client ID of the Spotify app music uses; the app's redirect URI is
# http://127.0.0.1:8888/callback.
# MIST_SPOTIFY_CLIENT_ID=<spotify-client-id>
# Spotify device music plays on when none is active.
# MIST_SPOTIFY_DEVICE=<device-name>
# Seconds past an alarm's time before an endpoint that cannot reach MIST rings on its own;
# 30 when unset, 5 to 300.
# MIST_RING_FALLBACK_AFTER_S=<seconds>

# --- Night extraction ---
# mist-extraction-llm and mist-extraction run only while `instance.py extraction apply` has
# them up. Beside MIST_RELEASE_TAG, MODELS_DIR and their two memory limits, they read only the
# four MIST_DAILY_EXTRACTION_* settings and the two identity variables below.

# Window extraction runs in, as HH:MM-HH:MM in host local time; 23:59-10:00 when unset. Only
# the host CLI reads it.
# MIST_EXTRACTION_WINDOW=<hh-mm-hh-mm>
# Model file under MODELS_DIR that the extraction llama-server loads.
# MIST_DAILY_EXTRACTION_MODEL_FILE=ggml-org/gpt-oss-20b-MXFP4.gguf
# Extraction llama-server context size in tokens.
# MIST_DAILY_EXTRACTION_CTX_SIZE=65536
# Number of MoE layers whose expert weights stay on the CPU; 21 by default. At 24, all of
# gpt-oss-20b's layers, the night rehearsal decoded 21.76 tokens per second, below its bar of 23.
# MIST_DAILY_EXTRACTION_NCMOE=21
# Extraction llama-server prompt-cache cap in MiB.
# MIST_DAILY_EXTRACTION_CACHE_RAM_MIB=2048
# Model identity stamped on every extraction result, gpt-oss-20b-mxfp4-<sha8> where <sha8> is
# the first eight hex digits of the model file's SHA-256. Extraction stays paused until it and
# EXTRACTION_LLM_DEVICE are set.
# EXTRACTION_MODEL_HASH=<model-hash>
# Name of the GPU the extraction llama-server runs on, for example rtx-4070-super.
# EXTRACTION_LLM_DEVICE=<gpu-name>

# --- Backups ---

# Absolute host path of the backup destination, outside the instance root and every work tree.
MIST_BACKUP_HOST_PATH=<absolute-path-to-backup-destination>
# Hours between successful backups.
# MIST_BACKUP_INTERVAL_HOURS=24
# Number of successful backups prune keeps.
# MIST_BACKUP_RETAIN=7
# Minutes between checks whether a backup is due.
# MIST_BACKUP_CHECK_MINUTES=10
# Minutes before a failed backup is retried.
# MIST_BACKUP_RETRY_MINUTES=60
# Least fraction of the last success's graph nodes a new backup must hold to count as a success.
# MIST_BACKUP_MIN_NODE_RATIO=0.5

# --- Gaming watcher ---
# Compose hands these lines to mist-backend too, which ignores them; `instance.py gaming-watch`
# on the host is their only reader.

# Game libraries: a program run from under one counts as a game unless the shipped table of
# launchers, clients, crash reporters, installers and anti-cheat, or MIST_GAME_EXCLUDE, names
# it. Separate them with a semicolon (;), with no quotes needed. Spaces inside a directory are
# kept and backslashes are literal; only the host CLI reads it.
# MIST_GAME_DIRS=<semicolon-separated-game-library-directories>
# Game instance and server folders: java.exe or javaw.exe counts as a game when its --gameDir,
# or else its working directory, lies under one. gaming-watch refuses while this and
# MIST_GAME_DIRS are both unset or empty. Separate them with a semicolon (;), with no quotes
# needed; only the host CLI reads it.
# MIST_GAME_RUNTIME_DIRS=<semicolon-separated-game-instance-and-server-directories>
# Host exclusions, for a non-game kept in a library: an entry with \, / or : is a directory,
# any other is a file name pattern such as tool*.exe. Separate them with a semicolon (;), with
# no quotes needed; only the host CLI reads it.
# MIST_GAME_EXCLUDE=<semicolon-separated-directories-or-file-name-patterns>
# Seconds between the watcher's process scans, 10 when unset; only the host CLI reads it.
# MIST_GAME_POLL_S=<seconds>
# Seconds with no game running before the watcher ends its own gaming mode.
# 120 when unset; only the host CLI reads it.
# MIST_GAME_RESUME_DELAY_S=<seconds>

# --- Memory limits (check them against `docker stats`) ---
# Neo4j's and the LLM's defaults are sized from measured peaks; the backend's and backup's are
# estimates.

# Memory limit of mist-backend; an estimate.
# MIST_DAILY_BACKEND_MEM_LIMIT=8g
# Memory limit of mist-neo4j; above its heap plus page cache, sized from its measured peak.
# MIST_DAILY_NEO4J_MEM_LIMIT=3g
# Memory limit of mist-llm; above the prompt-cache cap, sized from its measured peak.
# MIST_DAILY_LLM_MEM_LIMIT=9g
# Memory limit of mist-backup; an estimate.
# MIST_DAILY_BACKUP_MEM_LIMIT=4g
# Memory limit of mist-extraction-llm; the expert tensors on the CPU, the prompt-cache cap and
# 1 GiB for the server, an estimate.
# MIST_DAILY_EXTRACTION_LLM_MEM_LIMIT=14g
# Memory limit of mist-extraction; an estimate.
# MIST_DAILY_EXTRACTION_MEM_LIMIT=1g

# --- Ports (rehearsal only) ---
# The daily instance keeps the canonical ports, and `instance.py up` refuses any other for an
# instance named daily. Set these only for a rehearsal instance beside a running one.

# Rehearsal only: host port of the backend WebSocket.
# MIST_DAILY_WS_PORT=8001
# Rehearsal only: host port of Neo4j Bolt.
# MIST_DAILY_BOLT_PORT=7687
# Rehearsal only: host port of the Neo4j HTTP browser.
# MIST_DAILY_NEO4J_HTTP_PORT=7474
